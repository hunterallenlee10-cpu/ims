# Copy to .env.local for local work. Real values live only in .env.local (gitignored),
# Vercel environment variables, and n8n credentials. Never commit real keys.

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://example.com

# Stripe secret key for this environment (sk_live_... in Production)
STRIPE_SECRET_KEY=sk_live_replace_me

# Stripe customer portal login link (the "Manage membership" link)
NEXT_PUBLIC_STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/replace_me

# Bitcoin address for the $199 one-year BTC option (on-chain BTC only).
# The "Pay with BTC" button and /join/btc stay closed until this is set.
NEXT_PUBLIC_BTC_ADDRESS=

# Managed Payments (Stripe as merchant of record) is on by default for the account.
# Set to "false" only if you decide to handle sales tax/VAT yourself.
STRIPE_MANAGED_PAYMENTS=true

# Contact form delivery (e.g. an n8n webhook URL)
CONTACT_WEBHOOK_URL=https://example.com/webhook/replace_me
